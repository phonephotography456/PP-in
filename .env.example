# Copy to .env.local and set real values. Never commit .env.local.
POSTGRES_DB=phonephotography
POSTGRES_USER=phonephotography
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
DATABASE_URL=postgresql://phonephotography:change_me@localhost:5433/phonephotography

# Supabase Auth (service role key is server-only: never prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# Cloudflare R2 image storage (server-only: never prefix with NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for stored images, no trailing slash. r2.dev for development; set a custom domain here later.
R2_PUBLIC_URL=

# Public site (SEO). Canonical URLs, sitemap and robots.txt use this origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://phonephotography.in
# Real business contact details shown on /contact-us and in the policies. Leave empty until known.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Number of trusted reverse proxies in front of the app (X-Forwarded-For hops counted from the right). 0 = ignore the header.
TRUSTED_PROXY_HOPS=1
